{
  "functions": {
    "source": "functions"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/v/:id",
        "destination": "/view-bill.html?id=:id",
        "type": 301
      },
      {
        "source": "/a/:s/:b",
        "destination": "/advance-history.html?sup=:s&bid=:b",
        "type": 301
      },
      {
        "source": "/l/:id",
        "destination": "/loan-history.html?hl=:id",
        "type": 301
      },
      {
        "source": "/wl/:id",
        "destination": "/view-weekly-loan.html?id=:id",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
