rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(uid());
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userData() {
      return userExists() ? get(userPath()).data : null;
    }

    function isSuperAdmin() {
      return userExists() && userData().role == 'SUPER_ADMIN';
    }

    function hasGlobalOwnerAccessRole() {
      return userExists() && (
        userData().role in [
          'BUSINESS_OWNER',
          'DISTRIBUTOR_OWNER',
          'business_owner',
          'distributor_owner'
        ]
      );
    }

    function myPrimaryBusinessId() {
      return userExists() && 'businessId' in userData() && userData().businessId != null
        ? userData().businessId
        : null;
    }

    function bizUserPath(bid) {
      return /databases/$(database)/documents/businesses/$(bid)/users/$(uid());
    }

    function hasBizUserDoc(bid) {
      return signedIn() && exists(bizUserPath(bid));
    }

    function bizUserRole(bid) {
      return hasBizUserDoc(bid) ? get(bizUserPath(bid)).data.role : null;
    }

    function roleForBusiness(bid) {
      return hasBizUserDoc(bid)
        ? bizUserRole(bid)
        : (userExists() ? userData().role : null);
    }

    function isBusinessMember(bid) {
      return signedIn() && bid != null && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/businesses/$(bid)) &&
          get(/databases/$(database)/documents/businesses/$(bid)).data.ownerId == uid()
        ) ||
        myPrimaryBusinessId() == bid ||
        hasBizUserDoc(bid)
      );
    }

    function isRepInBusiness(bid) {
      return isBusinessMember(bid) && roleForBusiness(bid) in ['REP', 'rep'];
    }

    function isAccountantInBusiness(bid) {
      return isBusinessMember(bid) && roleForBusiness(bid) in ['ACCOUNTANT', 'accountant'];
    }

    function isOwnerClassInBusiness(bid) {
      return isSuperAdmin() || (
        isBusinessMember(bid) &&
        roleForBusiness(bid) in [
          'BUSINESS_OWNER',
          'DISTRIBUTOR_OWNER',
          'ADMIN',
          'business_owner',
          'distributor_owner',
          'admin'
        ]
      );
    }

    function isDistributorOpsInBusiness(bid) {
      return isOwnerClassInBusiness(bid) || (
        isBusinessMember(bid) &&
        roleForBusiness(bid) in [
          'WAREHOUSE_MANAGER',
          'DELIVERY_MANAGER',
          'warehouse_manager',
          'delivery_manager'
        ]
      );
    }

    function repDocPath(rid) {
      return /databases/$(database)/documents/reps/$(rid);
    }

    function repDocValidForCaller(rid) {
      return rid is string &&
        exists(repDocPath(rid)) &&
        get(repDocPath(rid)).data.businessId == myPrimaryBusinessId() &&
        (
          get(repDocPath(rid)).data.userId == uid() ||
          ('email' in get(repDocPath(rid)).data &&
            get(repDocPath(rid)).data.email == request.auth.token.email)
        );
    }

    function shopPath(sid) {
      return /databases/$(database)/documents/shops/$(sid);
    }

    function shopValidForRepOrder(bid, rid, sid) {
      return sid is string &&
        exists(shopPath(sid)) &&
        get(shopPath(sid)).data.businessId == bid &&
        get(shopPath(sid)).data.assignedRepId == rid;
    }

    function canReadDistributorOrder(bid) {
      return isSuperAdmin() || (
        isBusinessMember(bid) &&
        roleForBusiness(bid) != 'REP' &&
        (isOwnerClassInBusiness(bid) ||
          isAccountantInBusiness(bid) ||
          roleForBusiness(bid) in ['WAREHOUSE_MANAGER', 'DELIVERY_MANAGER', 'REP_SUPERVISOR'])
      );
    }

    function mwTradingSolutionsCanonicalBusinessId() {
      return 'YRMbB6aq4CMevSrLWkQvoVMtc8b2';
    }

    // mwTradingSolutionsTenant may only be true on the MW Trading Solutions business document
    function mwTradingSolutionsTenantWriteOk(businessId) {
      return !('mwTradingSolutionsTenant' in request.resource.data) ||
        request.resource.data.mwTradingSolutionsTenant != true ||
        businessId == mwTradingSolutionsCanonicalBusinessId();
    }

    function mwTradingOwnerBootstrapEmail() {
      return 'mwtradingsolutions@gmail.com';
    }

    function isMwTradingMasterCaller() {
      return signedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == mwTradingOwnerBootstrapEmail();
    }

    function mwTradingStaffLinkRoles() {
      return ['REP', 'ACCOUNTANT', 'BUSINESS_OWNER'];
    }

    function mwMasterStaffUserProfileCreateOk(createUid) {
      return isMwTradingMasterCaller() &&
        createUid is string &&
        createUid != uid() &&
        request.resource.data.keys().hasAll(['email', 'businessId', 'role']) &&
        request.resource.data.email is string &&
        request.resource.data.businessId == mwTradingSolutionsCanonicalBusinessId() &&
        request.resource.data.role in mwTradingStaffLinkRoles();
    }

    function mwMasterStaffBizUserWriteOk(businessId, staffUid) {
      return isMwTradingMasterCaller() &&
        businessId == mwTradingSolutionsCanonicalBusinessId() &&
        staffUid is string &&
        staffUid != uid() &&
        request.resource.data.keys().hasAll([
          'name',
          'email',
          'role',
          'businessId',
          'linkedAt',
          'linkedBy'
        ]) &&
        request.resource.data.businessId == businessId &&
        request.resource.data.linkedBy == uid() &&
        request.resource.data.role in mwTradingStaffLinkRoles();
    }

    function mwTradingOwnerSelfBizUser(businessId, staffUid) {
      return signedIn() &&
        businessId == mwTradingSolutionsCanonicalBusinessId() &&
        staffUid == uid() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == mwTradingOwnerBootstrapEmail();
    }

    // ----- Registration & identity -----
    match /users/{userId} {
      allow read: if signedIn() && (
        uid() == userId ||
        isSuperAdmin() ||
        (
          isMwTradingMasterCaller() &&
          'email' in resource.data
        )
      );
      allow create: if signedIn() && (
        uid() == userId ||
        isSuperAdmin() ||
        mwMasterStaffUserProfileCreateOk(userId) ||
        (isOwnerClassInBusiness(request.resource.data.businessId) &&
          request.resource.data.role == 'REP')
      );
      allow update: if signedIn() && (
        uid() == userId ||
        isSuperAdmin() ||
        (
          isOwnerClassInBusiness(request.resource.data.businessId) &&
          request.resource.data.businessId == myPrimaryBusinessId()
        ) ||
        (
          isMwTradingMasterCaller() &&
          userId != uid() &&
          request.resource.data.businessId == mwTradingSolutionsCanonicalBusinessId() &&
          request.resource.data.role in mwTradingStaffLinkRoles()
        )
      );
      allow delete: if signedIn() && (uid() == userId || isSuperAdmin());
    }

    match /businesses/{businessId} {
      allow read: if signedIn() && (isSuperAdmin() || isBusinessMember(businessId));
      allow create: if signedIn() && (
        isSuperAdmin() ||
        (businessId == uid() && request.resource.data.ownerName is string)
      ) && mwTradingSolutionsTenantWriteOk(businessId);
      allow update: if signedIn() && (
        isSuperAdmin() ||
        isOwnerClassInBusiness(businessId)
      ) && mwTradingSolutionsTenantWriteOk(businessId);
      allow delete: if signedIn() && (
        isSuperAdmin() ||
        isOwnerClassInBusiness(businessId)
      );

      match /users/{staffUid} {
        allow read: if signedIn() && (
          isSuperAdmin() ||
          isBusinessMember(businessId) ||
          (
            isMwTradingMasterCaller() &&
            businessId == mwTradingSolutionsCanonicalBusinessId()
          )
        );
        allow create: if signedIn() && (
          isSuperAdmin() ||
          isOwnerClassInBusiness(businessId) ||
          mwMasterStaffBizUserWriteOk(businessId, staffUid) ||
          (
            mwTradingOwnerSelfBizUser(businessId, staffUid) &&
            request.resource.data.keys().hasAll(['role', 'email', 'businessId']) &&
            request.resource.data.role == 'BUSINESS_OWNER' &&
            request.resource.data.email == mwTradingOwnerBootstrapEmail() &&
            request.resource.data.businessId == businessId
          )
        );
        allow update: if signedIn() && (
          isSuperAdmin() ||
          isOwnerClassInBusiness(businessId) ||
          mwMasterStaffBizUserWriteOk(businessId, staffUid) ||
          (
            mwTradingOwnerSelfBizUser(businessId, staffUid) &&
            request.resource.data.role == 'BUSINESS_OWNER' &&
            request.resource.data.email == mwTradingOwnerBootstrapEmail() &&
            request.resource.data.businessId == businessId
          )
        );
        allow delete: if signedIn() && (
          isSuperAdmin() ||
          isOwnerClassInBusiness(businessId)
        );
      }
    }

    // ----- Distributor: pending queue (reps create only) -----
    match /pendingOrders/{orderId} {
      allow read: if signedIn() && (
        isSuperAdmin() ||
        (
          resource.data.businessId is string &&
          isBusinessMember(resource.data.businessId) &&
          (
            roleForBusiness(resource.data.businessId) != 'REP' ||
            (
              resource.data.repId is string &&
              repDocValidForCaller(resource.data.repId)
            )
          )
        )
      );
      allow create: if signedIn() &&
        request.resource.data.businessId is string &&
        isRepInBusiness(request.resource.data.businessId) &&
        request.resource.data.businessId == myPrimaryBusinessId() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.repId is string &&
        repDocValidForCaller(request.resource.data.repId) &&
        request.resource.data.shopId is string &&
        shopValidForRepOrder(
          request.resource.data.businessId,
          request.resource.data.repId,
          request.resource.data.shopId
        );
      allow update: if signedIn() &&
        resource.data.businessId is string &&
        (
          isOwnerClassInBusiness(resource.data.businessId) ||
          (
            isRepInBusiness(resource.data.businessId) &&
            resource.data.repId is string &&
            repDocValidForCaller(resource.data.repId) &&
            request.resource.data.businessId == resource.data.businessId &&
            request.resource.data.repId == resource.data.repId &&
            request.resource.data.status == 'pending'
          )
        );
      allow delete: if signedIn() &&
        resource.data.businessId is string &&
        isOwnerClassInBusiness(resource.data.businessId);
    }

    // ----- Distributor: approved / operational orders (flat docs) -----
    match /orders/{orderId} {
      allow read: if signedIn() &&
        resource.data.keys().hasAll(['businessId']) &&
        canReadDistributorOrder(resource.data.businessId);
      allow create: if signedIn() &&
        request.resource.data.keys().hasAll(['businessId']) &&
        isOwnerClassInBusiness(request.resource.data.businessId);
      allow update: if signedIn() &&
        resource.data.keys().hasAll(['businessId']) &&
        request.resource.data.businessId == resource.data.businessId &&
        isDistributorOpsInBusiness(resource.data.businessId);
      allow delete: if signedIn() &&
        resource.data.keys().hasAll(['businessId']) &&
        isOwnerClassInBusiness(resource.data.businessId);
    }

    // ----- Retail / POS nested orders -----
    match /orders/{businessId}/list/{orderDocId} {
      allow read, write: if signedIn() && isBusinessMember(businessId);
    }

    // ----- Reps directory -----
    match /reps/{repId} {
      allow read: if signedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && isOwnerClassInBusiness(resource.data.businessId)) ||
        repDocValidForCaller(repId)
      );
      allow create: if signedIn() &&
        request.resource.data.businessId is string &&
        (
          isOwnerClassInBusiness(request.resource.data.businessId) ||
          (
            request.resource.data.keys().hasAll(['userId', 'email', 'businessId']) &&
            request.resource.data.userId == uid() &&
            request.auth.token.email == request.resource.data.email
          )
        );
      allow update, delete: if signedIn() &&
        resource.data.businessId is string &&
        isOwnerClassInBusiness(resource.data.businessId);
    }

    // ----- Shops -----
    match /shops/{shopId} {
      allow read: if signedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && isOwnerClassInBusiness(resource.data.businessId)) ||
        (
          resource.data.businessId is string &&
          isRepInBusiness(resource.data.businessId) &&
          'assignedRepId' in resource.data &&
          repDocValidForCaller(resource.data.assignedRepId)
        )
      );
      allow create: if signedIn() && (
        (request.resource.data.businessId is string &&
          isOwnerClassInBusiness(request.resource.data.businessId)) ||
        (
          request.resource.data.businessId is string &&
          isRepInBusiness(request.resource.data.businessId) &&
          request.resource.data.businessId == myPrimaryBusinessId() &&
          request.resource.data.assignedRepId is string &&
          repDocValidForCaller(request.resource.data.assignedRepId)
        )
      );
      allow update, delete: if signedIn() &&
        resource.data.businessId is string &&
        isOwnerClassInBusiness(resource.data.businessId);
    }

    // ----- Products (flat distributor rows + nested retail lists) -----
    match /products/{productDocId} {
      allow read: if signedIn() && (
        isSuperAdmin() ||
        isBusinessMember(productDocId) ||
        (resource.data.keys().hasAll(['businessId']) &&
          isBusinessMember(resource.data.businessId))
      );
      allow create: if signedIn() &&
        request.resource.data.keys().hasAll(['businessId']) &&
        isOwnerClassInBusiness(request.resource.data.businessId);
      allow update, delete: if signedIn() &&
        resource.data.keys().hasAll(['businessId']) &&
        request.resource.data.businessId == resource.data.businessId &&
        isOwnerClassInBusiness(resource.data.businessId);

      match /list/{itemId} {
        allow read: if signedIn() && isBusinessMember(productDocId);
        allow create, update, delete: if signedIn() &&
          isBusinessMember(productDocId) &&
          roleForBusiness(productDocId) != 'REP';
      }
    }

    // ----- Deliveries & picking batches -----
    match /deliveries/{deliveryId} {
      allow read: if signedIn() &&
        resource.data.businessId is string &&
        isDistributorOpsInBusiness(resource.data.businessId);
      allow create: if signedIn() &&
        request.resource.data.businessId is string &&
        isDistributorOpsInBusiness(request.resource.data.businessId);
      allow update, delete: if signedIn() &&
        resource.data.businessId is string &&
        isDistributorOpsInBusiness(resource.data.businessId);
    }

    match /stockBatches/{batchId} {
      allow read: if signedIn() &&
        resource.data.keys().hasAll(['orderId']) &&
        exists(/databases/$(database)/documents/orders/$(resource.data.orderId)) &&
        isDistributorOpsInBusiness(
          get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.businessId
        );
      allow create: if signedIn() &&
        request.resource.data.keys().hasAll(['orderId']) &&
        exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)) &&
        isDistributorOpsInBusiness(
          get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.businessId
        );
      allow update, delete: if signedIn() &&
        resource.data.keys().hasAll(['orderId']) &&
        exists(/databases/$(database)/documents/orders/$(resource.data.orderId)) &&
        isDistributorOpsInBusiness(
          get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.businessId
        );
    }

    match /events/{eventId} {
      allow create: if signedIn();
      allow read, update, delete: if isSuperAdmin();
    }

    match /prescriptions/{docId} {
      allow read: if signedIn() &&
        resource.data.businessId is string &&
        isBusinessMember(resource.data.businessId);
      allow create: if signedIn() &&
        request.resource.data.businessId is string &&
        isBusinessMember(request.resource.data.businessId);
      allow update, delete: if signedIn() &&
        resource.data.businessId is string &&
        isBusinessMember(resource.data.businessId);
    }

    match /appointments/{docId} {
      allow read: if signedIn() &&
        resource.data.businessId is string &&
        isBusinessMember(resource.data.businessId);
      allow create: if signedIn() &&
        request.resource.data.businessId is string &&
        isBusinessMember(request.resource.data.businessId);
      allow update, delete: if signedIn() &&
        resource.data.businessId is string &&
        isBusinessMember(resource.data.businessId);
    }

    match /serviceBills/{docId} {
      allow read: if signedIn() &&
        resource.data.businessId is string &&
        isBusinessMember(resource.data.businessId);
      allow create: if signedIn() &&
        request.resource.data.businessId is string &&
        isBusinessMember(request.resource.data.businessId);
      allow update, delete: if signedIn() &&
        resource.data.businessId is string &&
        isBusinessMember(resource.data.businessId);
    }

    match /clients/{docId} {
      allow read: if signedIn() &&
        resource.data.businessId is string &&
        isBusinessMember(resource.data.businessId);
      allow create: if signedIn() &&
        request.resource.data.businessId is string &&
        isBusinessMember(request.resource.data.businessId);
      allow update, delete: if signedIn() &&
        resource.data.businessId is string &&
        isBusinessMember(resource.data.businessId);
    }

    // ----- Accounting & retail data keyed by business -----
    match /accounts/{bid}/list/{code} {
      allow read, write: if signedIn() && (isSuperAdmin() || isBusinessMember(bid));
    }

    match /journal/{bid}/entries/{entryId} {
      allow read, write: if signedIn() && (isSuperAdmin() || isBusinessMember(bid));
    }

    match /journal/{bid}/account_ledger/{acctId} {
      allow read, write: if signedIn() && (isSuperAdmin() || isBusinessMember(bid));
    }

    match /journal/{bid}/ledger_opening/{docId} {
      allow read, write: if signedIn() && (isSuperAdmin() || isBusinessMember(bid));
    }

    match /settings/{bid} {
      allow read, write: if signedIn() && (isSuperAdmin() || isBusinessMember(bid));
    }

    match /customers/{bid}/list/{cid} {
      allow read, write: if signedIn() && (isSuperAdmin() || isBusinessMember(bid));
    }

    match /suppliers/{bid}/list/{sid} {
      allow read, write: if signedIn() && (isSuperAdmin() || isBusinessMember(bid));
    }

    match /purchases/{bid}/orders/{oid} {
      allow read, write: if signedIn() && (isSuperAdmin() || isBusinessMember(bid));
    }

    match /customerTransactions/{bid}/list/{tid} {
      allow read, write: if signedIn() && (isSuperAdmin() || isBusinessMember(bid));
    }

    match /stockMovements/{movementId} {
      allow read: if signedIn() &&
        resource.data.productId is string &&
        exists(/databases/$(database)/documents/products/$(resource.data.productId)) &&
        get(/databases/$(database)/documents/products/$(resource.data.productId)).data.keys().hasAll(['businessId']) &&
        isDistributorOpsInBusiness(
          get(/databases/$(database)/documents/products/$(resource.data.productId)).data.businessId
        );
      allow create: if signedIn() &&
        request.resource.data.productId is string &&
        exists(/databases/$(database)/documents/products/$(request.resource.data.productId)) &&
        get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.keys().hasAll(['businessId']) &&
        isDistributorOpsInBusiness(
          get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.businessId
        );
      allow update, delete: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if signedIn() &&
        resource.data.businessId is string &&
        isDistributorOpsInBusiness(resource.data.businessId);
      allow create, update, delete: if signedIn() &&
        request.resource.data.businessId is string &&
        isOwnerClassInBusiness(request.resource.data.businessId);
    }

    // ----- Web loan modules (journal entries + SMS from loan pages) -----
    match /hand_loans/{loanId} {
      allow read: if signedIn() && resource.data.businessId is string && isBusinessMember(resource.data.businessId);
      allow create: if signedIn() && request.resource.data.businessId is string && isBusinessMember(request.resource.data.businessId);
      allow update, delete: if signedIn() && resource.data.businessId is string && isBusinessMember(resource.data.businessId);
    }
    match /loan_no_interest/{loanId} {
      allow read: if signedIn() && resource.data.businessId is string && isBusinessMember(resource.data.businessId);
      allow create: if signedIn() && request.resource.data.businessId is string && isBusinessMember(request.resource.data.businessId);
      allow update, delete: if signedIn() && resource.data.businessId is string && isBusinessMember(resource.data.businessId);
    }
    match /loan_interest_entries/{loanId} {
      allow read: if signedIn() && resource.data.businessId is string && isBusinessMember(resource.data.businessId);
      allow create: if signedIn() && request.resource.data.businessId is string && isBusinessMember(request.resource.data.businessId);
      allow update, delete: if signedIn() && resource.data.businessId is string && isBusinessMember(resource.data.businessId);
    }
    match /loan_advanced_entries/{loanId} {
      allow read: if signedIn() && resource.data.businessId is string && isBusinessMember(resource.data.businessId);
      allow create: if signedIn() && request.resource.data.businessId is string && isBusinessMember(request.resource.data.businessId);
      allow update, delete: if signedIn() && resource.data.businessId is string && isBusinessMember(resource.data.businessId);
    }

    match /investor_capital_ledger/{lineId} {
      allow read: if signedIn() && resource.data.businessId is string && isBusinessMember(resource.data.businessId);
      allow create: if signedIn() && request.resource.data.businessId is string && isBusinessMember(request.resource.data.businessId);
      allow update, delete: if signedIn() && resource.data.businessId is string && isBusinessMember(resource.data.businessId);
    }

    match /investor_portfolio_config/{bid} {
      allow read, write: if signedIn() && isBusinessMember(bid);
    }

    match /investor_payouts/{payoutId} {
      allow read: if signedIn() && resource.data.businessId is string && isBusinessMember(resource.data.businessId);
      allow create: if signedIn() && request.resource.data.businessId is string && isBusinessMember(request.resource.data.businessId);
      allow update, delete: if signedIn() && resource.data.businessId is string && isBusinessMember(resource.data.businessId);
    }

    match /investor_ledger/{ledgerId} {
      allow read: if signedIn() && resource.data.businessId is string && isBusinessMember(resource.data.businessId);
      allow create: if signedIn() && request.resource.data.businessId is string && isBusinessMember(request.resource.data.businessId);
      allow update, delete: if false;
    }

    /** REPs were blocked from pending_sms; loan/hand modules enqueue with createdBy markers. */
    function isLoanRelatedSmsCreatedBy() {
      return 'createdBy' in request.resource.data &&
        request.resource.data.createdBy is string &&
        (
          request.resource.data.createdBy == 'scrapVbaCore.enqueuePendingSms' ||
          request.resource.data.createdBy.matches('.*[Ll]oan.*') ||
          request.resource.data.createdBy.matches('.*handloan.*') ||
          request.resource.data.createdBy.matches('.*advloan.*') ||
          request.resource.data.createdBy.matches('.*noint.*')
        );
    }

    function isLoanRelatedSmsLogSource() {
      return ('deliverySource' in request.resource.data &&
          request.resource.data.deliverySource is string &&
          (
            request.resource.data.deliverySource.matches('.*[Ll]oan.*') ||
            request.resource.data.deliverySource.matches('.*handloan.*') ||
            request.resource.data.deliverySource.matches('.*advloan.*') ||
            request.resource.data.deliverySource.matches('.*noint.*')
          )) ||
        ('createdBy' in request.resource.data &&
          request.resource.data.createdBy is string &&
          request.resource.data.createdBy.matches('.*[Ll]oan.*'));
    }

    // ----- SMS queue (web enqueues; Android gateway reads pending, updates status to "sent") -----
    // Query example: .where("businessId","==",bid).where("status","==","pending") — composite index in firestore.indexes.json
    match /pending_sms/{smsId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasAll(['businessId', 'mobile', 'message', 'status', 'createdAt']) &&
        request.resource.data.businessId is string &&
        request.resource.data.mobile is string &&
        request.resource.data.message is string &&
        request.resource.data.status == 'pending' &&
        isBusinessMember(request.resource.data.businessId) &&
        (
          isSuperAdmin() ||
          isOwnerClassInBusiness(request.resource.data.businessId) ||
          isAccountantInBusiness(request.resource.data.businessId) ||
          (
            isBusinessMember(request.resource.data.businessId) &&
            roleForBusiness(request.resource.data.businessId) != 'REP' &&
            roleForBusiness(request.resource.data.businessId) != 'rep'
          ) ||
          isLoanRelatedSmsCreatedBy()
        );
      allow read: if signedIn() &&
        resource.data.businessId is string &&
        isBusinessMember(resource.data.businessId);
      allow update: if signedIn() &&
        resource.data.businessId is string &&
        isBusinessMember(resource.data.businessId) &&
        (
          isSuperAdmin() ||
          isOwnerClassInBusiness(resource.data.businessId) ||
          isAccountantInBusiness(resource.data.businessId) ||
          (
            roleForBusiness(resource.data.businessId) != 'REP' &&
            roleForBusiness(resource.data.businessId) != 'rep'
          )
        );
      allow delete: if signedIn() &&
        resource.data.businessId is string &&
        (
          isSuperAdmin() ||
          isOwnerClassInBusiness(resource.data.businessId)
        );
    }

    // ----- SMS delivery audit trail -----
    // Source-of-truth log for queued/sent/failed transitions.
    match /sms_logs/{logId} {
      allow create: if signedIn() &&
        request.resource.data.businessId is string &&
        isBusinessMember(request.resource.data.businessId) &&
        (
          isSuperAdmin() ||
          isOwnerClassInBusiness(request.resource.data.businessId) ||
          isAccountantInBusiness(request.resource.data.businessId) ||
          (
            roleForBusiness(request.resource.data.businessId) != 'REP' &&
            roleForBusiness(request.resource.data.businessId) != 'rep'
          ) ||
          isLoanRelatedSmsLogSource()
        );
      allow read: if signedIn() &&
        resource.data.businessId is string &&
        isBusinessMember(resource.data.businessId);
      allow update: if signedIn() &&
        resource.data.businessId is string &&
        isBusinessMember(resource.data.businessId) &&
        (
          isSuperAdmin() ||
          isOwnerClassInBusiness(resource.data.businessId) ||
          isAccountantInBusiness(resource.data.businessId) ||
          (
            roleForBusiness(resource.data.businessId) != 'REP' &&
            roleForBusiness(resource.data.businessId) != 'rep'
          )
        );
      allow delete: if signedIn() &&
        resource.data.businessId is string &&
        (
          isSuperAdmin() ||
          isOwnerClassInBusiness(resource.data.businessId)
        );
    }

    // ----- SMS gateway mirror (same payload as /pending_sms; Android / RTDB bridge) -----
    // Without this block, writes fell through to /{document=**} and required hasGlobalOwnerAccessRole().
    match /sms_gateway/{bid}/pending_sms/{smsId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasAll(['businessId', 'mobile', 'message', 'status', 'createdAt']) &&
        request.resource.data.businessId is string &&
        request.resource.data.businessId == bid &&
        request.resource.data.mobile is string &&
        request.resource.data.message is string &&
        request.resource.data.status == 'pending' &&
        isBusinessMember(bid) &&
        (
          isSuperAdmin() ||
          isOwnerClassInBusiness(bid) ||
          isAccountantInBusiness(bid) ||
          (
            isBusinessMember(bid) &&
            roleForBusiness(bid) != 'REP' &&
            roleForBusiness(bid) != 'rep'
          )
        );
      allow read: if signedIn() &&
        resource.data.businessId is string &&
        isBusinessMember(resource.data.businessId);
      allow update: if signedIn() &&
        resource.data.businessId is string &&
        isBusinessMember(resource.data.businessId) &&
        (
          isSuperAdmin() ||
          isOwnerClassInBusiness(resource.data.businessId) ||
          isAccountantInBusiness(resource.data.businessId) ||
          (
            isBusinessMember(resource.data.businessId) &&
            roleForBusiness(resource.data.businessId) != 'REP' &&
            roleForBusiness(resource.data.businessId) != 'rep'
          )
        );
      allow delete: if signedIn() &&
        resource.data.businessId is string &&
        (
          isSuperAdmin() ||
          isOwnerClassInBusiness(resource.data.businessId)
        );
    }

    // ----- MW / distributor: append-only product price & metadata audit -----
    match /product_audit_log/{logId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasAll(['businessId', 'productId', 'source', 'createdAt']) &&
        request.resource.data.businessId is string &&
        request.resource.data.productId is string &&
        request.resource.data.source is string &&
        isBusinessMember(request.resource.data.businessId) &&
        roleForBusiness(request.resource.data.businessId) != 'REP';
      allow read: if signedIn() &&
        resource.data.businessId is string &&
        isBusinessMember(resource.data.businessId);
      allow update, delete: if false;
    }

    // ----- Safe default for remaining collections -----
    // Uses existing business membership model (users/{uid}.businessId and businesses/{bid}/users/{uid}).
    match /{document=**} {
      allow read: if signedIn() && (
        isSuperAdmin() ||
        (resource.data.keys().hasAll(['businessId']) &&
          isBusinessMember(resource.data.businessId)) ||
        hasGlobalOwnerAccessRole()
      );
      allow create: if signedIn() && (
        isSuperAdmin() ||
        (request.resource.data.keys().hasAll(['businessId']) &&
          isBusinessMember(request.resource.data.businessId)) ||
        hasGlobalOwnerAccessRole()
      );
      allow update: if signedIn() && (
        isSuperAdmin() ||
        (
          resource.data.keys().hasAll(['businessId']) &&
          request.resource.data.keys().hasAll(['businessId']) &&
          resource.data.businessId == request.resource.data.businessId &&
          isBusinessMember(resource.data.businessId)
        ) ||
        hasGlobalOwnerAccessRole()
      );
      allow delete: if signedIn() && (
        isSuperAdmin() ||
        (resource.data.keys().hasAll(['businessId']) &&
          isBusinessMember(resource.data.businessId)) ||
        hasGlobalOwnerAccessRole()
      );
    }
  }
}
