rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security and multi-tenancy
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == 'SUPER_ADMIN') ||
        (getUserData() != null && getUserData().role == 'SUPER_ADMIN')
      );
    }

    function belongsToBusiness(businessId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.token != null && request.auth.token.businessId == businessId) ||
        (getUserData() != null && (getUserData().businessId == businessId || getUserData().assignedBusiness == businessId))
      );
    }

    // Default rule: All documents require authentication
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Users Collection Protection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    // Business Tenant Collection & Subcollections Protection
    match /businesses/{businessId} {
      allow read, write: if belongsToBusiness(businessId);

      match /{allSubcollections=**} {
        allow read, write: if belongsToBusiness(businessId);
      }
    }

    // Audit Logs Collection Protection
    match /audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isSuperAdmin() || (resource != null && belongsToBusiness(resource.data.businessId));
      allow update, delete: if isSuperAdmin();
    }

    // Client Version Control Collection Protection
    match /client_version_control/{vcId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}
