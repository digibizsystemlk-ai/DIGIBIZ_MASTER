{
  "rules": {
    "pending_sms": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['0', '1']) && newData.child('0').isString() && newData.child('1').isString() && newData.childrenCount() == 2"
      }
    },
    "sms_gateway": {
      "$businessId": {
        "pending_sms": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$msgId": {
            ".read": "auth != null",
            ".write": "auth != null",
            ".validate": "!newData.exists() || (newData.hasChild('mobile') && newData.hasChild('message') && newData.child('mobile').isString() && newData.child('message').isString())"
          }
        }
      }
    }
  }
}
