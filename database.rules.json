{
  "rules": {
    "sms_gateway": {
      "$businessId": {
        "pending_sms": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$msgId": {
            ".read": "auth != null",
            ".write": "auth != null",
            ".validate": "!newData.exists() || (newData.hasChild('mobile') && newData.hasChild('message') && newData.child('mobile').isString() && newData.child('message').isString())"
          }
        }
      }
    },
    "users": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
